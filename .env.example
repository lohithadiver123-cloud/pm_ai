# Backend environment example
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app-name>
DB_NAME=pm_copilot
SECRET_KEY=change-me-to-a-secure-secret-key

# (Optional) Groq AI API Key for LLM-powered insights
GROQ_API_KEY=

# Frontend uses Vite proxy and does not normally require env vars
