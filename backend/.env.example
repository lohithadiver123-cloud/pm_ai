# Backend environment variables
# MongoDB (Optional: falls back automatically to local in-memory storage if omitted or unreachable)
MONGO_URI=mongodb://localhost:27017
DB_NAME=pm_copilot

# JWT Security
SECRET_KEY=pm-copilot-super-secret-key-change-in-production

# AI Engine Configuration
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional: Groq AI configuration
GROQ_API_KEY=
GROQ_MODEL=allam-2-7b
